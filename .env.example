# .env.example — copy to .env.production and fill in real values before deploying
# Never commit .env.production to git

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=connectwave
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=connectwave
DATABASE_URL=postgresql://connectwave:<password>@postgres:5432/connectwave

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=<strong-random-password>
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ── JWT (same across all services — 32+ random bytes) ─────────────────────────
JWT_SECRET=<openssl rand -base64 32>

# ── TURN server ───────────────────────────────────────────────────────────────
TURN_SECRET=<openssl rand -base64 32>
TURN_HOST=<your-vps-public-ip-or-domain>
TURN_PORT=3478

# ── App ───────────────────────────────────────────────────────────────────────
CLIENT_URL=https://your-domain.com
NODE_ENV=production
MAX_PEERS_PER_ROOM=12
ROOM_TTL_SECONDS=86400

# ── Nginx/TLS ─────────────────────────────────────────────────────────────────
DOMAIN=your-domain.com
