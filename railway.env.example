# Railway environment variables for ConnectWave (signaling server)
#
# Option A — managed Redis (recommended for production):
# 1. Run: npx @railway/cli login && npx @railway/cli link
# 2. Run: node scripts/setup-railway-redis.mjs
#    Or manually: + New → Database → Redis, then set:
#    REDIS_URL=${{Redis.REDIS_URL}}
#
# Option B — bundled Redis (zero-config fallback):
# The root Dockerfile starts a local Redis when REDIS_URL is unset.
# No variable needed; redeploy after pushing the Dockerfile.

# Shared with room-service and chat-service — use the same value on all three
JWT_SECRET=replace-with-openssl-rand-base64-32

# Frontend origin for CORS (set to your client/nginx public URL)
CLIENT_URL=https://your-frontend-domain.example

# If room-service and chat-service are also on Railway, set these on ConnectWave too:
# ROOM_SERVICE_URL=${{room-service.RAILWAY_PRIVATE_DOMAIN}}
# CHAT_SERVICE_URL=${{chat-service.RAILWAY_PRIVATE_DOMAIN}}
