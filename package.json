{
  "name": "connectwave",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix room-service\" \"npm run dev --prefix client\"",
    "dev:room": "npm run dev --prefix room-service",
    "dev:docker": "docker-compose up --build",
    "dev:scale": "docker-compose up --build --scale signaling=2",
    "install:room-service": "npm install --prefix room-service",
    "install:all": "npm install --prefix server && npm install --prefix client && npm install --prefix room-service",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f signaling"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
