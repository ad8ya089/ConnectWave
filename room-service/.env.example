NODE_ENV=development
PORT=4001

REDIS_URL=redis://localhost:6379

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/connectwave

# Must match JWT_SECRET in server/.env exactly
JWT_SECRET=dev-secret-change-in-production
JOIN_TOKEN_TTL_SEC=300

CLIENT_URL=http://localhost:5173
SIGNALING_URL=http://localhost:4000

MAX_PEERS_PER_ROOM=12
ROOM_ID_LENGTH=8
ROOM_INACTIVE_TTL=86400

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# TURN server
TURN_SECRET=dev-turn-secret-change-in-production
TURN_HOST=localhost
TURN_PORT=3478
TURN_TTL_SEC=3600
